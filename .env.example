# Kurgu yerel geliştirme ortamı. Kopyalayın: cp .env.example .env
# Bu dosyada gerçek sır bulunmaz. Değerler yalnızca yerel geliştirme içindir.

# --- Portlar (çakışma olursa değiştirin) ---
WEB_PORT=3000
API_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
KEYCLOAK_PORT=8080
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# --- PostgreSQL ---
POSTGRES_DB=kurgu
POSTGRES_SUPERUSER_PASSWORD=change-me-superuser
KURGU_OWNER_PASSWORD=change-me-owner
KURGU_APP_PASSWORD=change-me-app
KURGU_WORKER_PASSWORD=change-me-worker

# Uygulamanın bağlandığı adresler (compose içinden "postgres" host adı kullanılır)
DATABASE_URL=postgresql+asyncpg://kurgu_app:change-me-app@localhost:5432/kurgu
MIGRATIONS_DATABASE_URL=postgresql+asyncpg://kurgu_owner:change-me-owner@localhost:5432/kurgu
WORKER_DATABASE_URL=postgresql+asyncpg://kurgu_worker:change-me-worker@localhost:5432/kurgu

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Object storage (MinIO) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=kurgu-minio
S3_SECRET_KEY=change-me-minio
S3_BUCKET=kurgu
# Yerel depo (KURGU_STORAGE_BACKEND=local) imzalı adresleri için; geliştirmede boş bırakılabilir.
KURGU_STORAGE_SIGNING_KEY=

# --- OIDC (yerelde Keycloak) ---
# Tarayıcının gördüğü adres ile konteynerlerin gördüğü adres farklı olabilir.
OIDC_ISSUER=http://localhost:8080/realms/kurgu
OIDC_INTERNAL_ISSUER=http://keycloak:8080/realms/kurgu
OIDC_CLIENT_ID=kurgu-web
OIDC_CLIENT_SECRET=change-me-oidc-client
OIDC_AUDIENCE=kurgu-api
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-admin
# Keycloak test kullanıcılarının ortak parolası (yalnız yerel)
KURGU_DEV_USER_PASSWORD=change-me-dev-user

# --- Web (Auth.js) ---
AUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000
API_INTERNAL_URL=http://localhost:8000

# --- API ---
KURGU_ENV=development
KURGU_LOG_LEVEL=INFO
# Yerelde MFA kontrolü kapalı (ADR-0005)
KURGU_REQUIRE_MFA=false
CORS_ORIGINS=http://localhost:3000

# --- LLM (Faz 6). ANTHROPIC_API_KEY / ANTHROPIC_MODEL adlarını KULLANMAYIN. ---
KURGU_LLM_MODEL=
KURGU_ANTHROPIC_API_KEY=
