  "authenticationFlows": [
    {
      "alias": "kurgu-browser",
      "description": "İki düzeyli tarayıcı akışı: düzey 1 parola, düzey 2 TOTP (ADR-0016).",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticator": "auth-cookie",
          "authenticatorFlow": false
        },
        {
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "userSetupAllowed": false,
          "flowAlias": "kurgu-forms",
          "authenticatorFlow": true
        }
      ]
    },
    {
      "alias": "kurgu-forms",
      "description": "Parola ve istenirse TOTP.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "CONDITIONAL",
          "priority": 10,
          "userSetupAllowed": false,
          "flowAlias": "kurgu-level-1",
          "authenticatorFlow": true
        },
        {
          "requirement": "CONDITIONAL",
          "priority": 20,
          "userSetupAllowed": false,
          "flowAlias": "kurgu-level-2",
          "authenticatorFlow": true
        }
      ]
    },
    {
      "alias": "kurgu-level-1",
      "description": "Düzey 1: kullanıcı adı ve parola.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticator": "conditional-level-of-authentication",
          "authenticatorFlow": false,
          "authenticatorConfig": "kurgu-loa-1"
        },
        {
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false,
          "authenticator": "auth-username-password-form",
          "authenticatorFlow": false
        }
      ]
    },
    {
      "alias": "kurgu-level-2",
      "description": "Düzey 2: tek kullanımlık kod (TOTP).",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticator": "conditional-level-of-authentication",
          "authenticatorFlow": false,
          "authenticatorConfig": "kurgu-loa-2"
        },
        {
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false,
          "authenticator": "auth-otp-form",
          "authenticatorFlow": false
        }
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "kurgu-loa-1",
      "config": {
        "loa-condition-level": "1",
        "loa-max-age": "36000"
      }
    },
    {
      "alias": "kurgu-loa-2",
      "config": {
        "loa-condition-level": "2",
        "loa-max-age": "36000"
      }
    }
  ]
}
