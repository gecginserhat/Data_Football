          },
          {
            "description": "Sezon kimliği",
            "in": "query",
            "name": "season",
            "required": true,
            "schema": {
              "description": "Sezon kimliği",
              "format": "uuid",
              "title": "Season",
              "type": "string"
            }
          },
          {
            "in": "header",
